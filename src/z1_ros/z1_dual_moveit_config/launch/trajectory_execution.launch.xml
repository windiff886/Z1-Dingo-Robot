<launch>
  <!-- NOTE: this is what we use to connect to the controllers -->
  <!-- Flag indicating whether MoveIt should execute trajectoires. -->
  <arg name="moveit_manage_controllers" default="true"/>
  <arg name="moveit_controller_manager" default="z1_description" />
  
  <!-- Load controller configuration -->
  <rosparam command="load" file="$(find z1_dual_moveit_config)/config/ros_controllers.yaml"/>
  
  <param name="use_controller_manager" value="false" />
  <param name="trajectory_execution/execution_duration_monitoring" value="false" />
  
  <!-- MoveIt Controller Manager -->
  <arg name="moveit_controller_manager_launch" default="moveit_simple_controller_manager/MoveItSimpleControllerManager"/>
  
  <param name="moveit_controller_manager" value="$(arg moveit_controller_manager_launch)"/>
</launch>
