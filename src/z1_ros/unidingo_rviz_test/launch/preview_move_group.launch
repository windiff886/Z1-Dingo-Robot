<launch>
  <!-- Official MoveIt scene/kinematics context; hardware execution stays with PoseGoal. -->
  <param name="robot_description_semantic" textfile="$(find unidingo_rviz_test)/config/dual_arm.srdf"/>
  <rosparam ns="robot_description_kinematics" command="load" file="$(find unidingo_rviz_test)/config/kinematics.yaml"/>
  <rosparam ns="robot_description_planning" command="load" file="$(find unidingo_rviz_test)/config/joint_limits.yaml"/>
  <node name="move_group" pkg="moveit_ros_move_group" type="move_group" output="screen">
    <remap from="joint_states" to="/rviz_tcp_test/joint_states"/>
    <param name="allow_trajectory_execution" value="false"/>
    <param name="default_planning_pipeline" value="ompl"/>
    <rosparam ns="planning_pipelines/ompl" command="load" file="$(find unidingo_rviz_test)/config/ompl_planning.yaml"/>
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_transforms_updates" value="true"/>
  </node>
</launch>
