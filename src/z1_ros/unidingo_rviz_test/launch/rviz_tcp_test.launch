<launch>
  <include file="$(find z1_bringup)/launch/controllers.launch" />
  <param name="robot_description" command="$(find xacro)/xacro '$(find uni_dingo)/urdf/uni_dingo_dual_arm.urdf.xacro' UnitreeGripper:=true PanTilt:=true" />
  <include file="$(find unidingo_rviz_test)/launch/preview_move_group.launch" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="whole_robot_state_publisher">
    <remap from="joint_states" to="/rviz_tcp_test/joint_states" />
  </node>
  <group ns="rviz_tcp_test">
    <node pkg="unidingo_rviz_test" type="z1_pose_preview" name="left_preview" output="screen" required="true">
      <param name="controller_namespace" value="/left_arm/controller" />
    </node>
    <node pkg="unidingo_rviz_test" type="z1_pose_preview" name="right_preview" output="screen" required="true">
      <param name="controller_namespace" value="/right_arm/controller" />
    </node>
  </group>
  <node pkg="unidingo_rviz_test" type="interactive_tcp_test.py" name="rviz_tcp_test" output="screen" required="true">
    <rosparam command="load" file="$(find unidingo_rviz_test)/config/rviz_tcp_test.yaml" />
  </node>
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find unidingo_rviz_test)/rviz/tcp_test.rviz" />
</launch>
