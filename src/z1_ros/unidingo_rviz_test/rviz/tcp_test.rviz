Panels:
- Class: rviz/Displays
  Name: Displays
- Class: unidingo_rviz_test/TargetPanel
  Name: TCP targets
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
  - Class: rviz/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.1
    Plane Cell Count: 30
  - Class: rviz/RobotModel
    Name: Measured robot
    Enabled: true
    Robot Description: robot_description
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
  - Class: unidingo_rviz_test/SdkMotionPlanning
    Name: MoveIt SDK targets
    Enabled: true
    Robot Description: robot_description
    Planning Scene Topic: /move_group/monitored_planning_scene
    MoveIt_Use_Constraint_Aware_IK: false
    MoveIt_Allow_Approximate_IK: false
    Planning Request:
      Planning Group: left_arm
      Query Goal State: true
      Query Start State: false
      Goal State Alpha: 0.65
      Goal State Color: 250; 128; 0
      Interactive Marker Size: 0.12
      Show Workspace: false
    Planned Path:
      Trajectory Topic: /rviz_tcp_test/preview_trajectory
      Robot Alpha: 0.3
      Robot Color: 210; 165; 255
      Color Enabled: true
      Show Robot Collision: false
      Show Robot Visual: true
      Show Trail: false
      Loop Animation: true
      Interrupt Display: true
      State Display Time: 3x
    Scene Robot:
      Show Scene Robot: false
    Scene Geometry:
      Show Scene Geometry: false
  - Class: rviz/TF
    Name: TF
    Enabled: false
  Tools:
  - Class: rviz/Interact
    Hide Inactive Objects: false
  - Class: rviz/MoveCamera
  - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 2.7
      Focal Point:
        X: 0.1
        Y: 0
        Z: 0.65
      Pitch: 0.35
      Yaw: 0.8
  Name: root
Window Geometry:
  Width: 1440
  Height: 900
