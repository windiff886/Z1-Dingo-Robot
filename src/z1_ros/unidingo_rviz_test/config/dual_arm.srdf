<?xml version="1.0"?>
<!-- Home and collision exclusions from Unitree z1_ros d3bafd38.
     Each official arm chain extends through the fixed SDK TCP frame. -->
<robot name="uni_dingo_dual_arm">
  <group name="left_arm">
    <chain base_link="left_link00" tip_link="left_tool" />
  </group>
  <group_state name="home" group="left_arm">
    <joint name="left_joint1" value="0" />
    <joint name="left_joint2" value="0" />
    <joint name="left_joint3" value="0" />
    <joint name="left_joint4" value="-0.07435" />
    <joint name="left_joint5" value="0" />
    <joint name="left_joint6" value="0" />
  </group_state>
  <disable_collisions link1="left_gripperMover" link2="left_gripperStator" reason="Adjacent" />
  <disable_collisions link1="left_gripperMover" link2="left_link03" reason="Never" />
  <disable_collisions link1="left_gripperMover" link2="left_link04" reason="Never" />
  <disable_collisions link1="left_gripperMover" link2="left_link06" reason="Never" />
  <disable_collisions link1="left_gripperStator" link2="left_link03" reason="Never" />
  <disable_collisions link1="left_gripperStator" link2="left_link04" reason="Never" />
  <disable_collisions link1="left_gripperStator" link2="left_link06" reason="Adjacent" />
  <disable_collisions link1="left_link00" link2="left_link02" reason="Adjacent" />
  <disable_collisions link1="left_link00" link2="left_link03" reason="Never" />
  <disable_collisions link1="left_link00" link2="left_link04" reason="Never" />
  <disable_collisions link1="left_link02" link2="left_link03" reason="Adjacent" />
  <disable_collisions link1="left_link03" link2="left_link04" reason="Adjacent" />
  <disable_collisions link1="left_link03" link2="left_link06" reason="Never" />
  <disable_collisions link1="left_link04" link2="left_link06" reason="Adjacent" />
  <group name="right_arm">
    <chain base_link="right_link00" tip_link="right_tool" />
  </group>
  <group_state name="home" group="right_arm">
    <joint name="right_joint1" value="0" />
    <joint name="right_joint2" value="0" />
    <joint name="right_joint3" value="0" />
    <joint name="right_joint4" value="-0.07435" />
    <joint name="right_joint5" value="0" />
    <joint name="right_joint6" value="0" />
  </group_state>
  <disable_collisions link1="right_gripperMover" link2="right_gripperStator" reason="Adjacent" />
  <disable_collisions link1="right_gripperMover" link2="right_link03" reason="Never" />
  <disable_collisions link1="right_gripperMover" link2="right_link04" reason="Never" />
  <disable_collisions link1="right_gripperMover" link2="right_link06" reason="Never" />
  <disable_collisions link1="right_gripperStator" link2="right_link03" reason="Never" />
  <disable_collisions link1="right_gripperStator" link2="right_link04" reason="Never" />
  <disable_collisions link1="right_gripperStator" link2="right_link06" reason="Adjacent" />
  <disable_collisions link1="right_link00" link2="right_link02" reason="Adjacent" />
  <disable_collisions link1="right_link00" link2="right_link03" reason="Never" />
  <disable_collisions link1="right_link00" link2="right_link04" reason="Never" />
  <disable_collisions link1="right_link02" link2="right_link03" reason="Adjacent" />
  <disable_collisions link1="right_link03" link2="right_link04" reason="Adjacent" />
  <disable_collisions link1="right_link03" link2="right_link06" reason="Never" />
  <disable_collisions link1="right_link04" link2="right_link06" reason="Adjacent" />
</robot>
