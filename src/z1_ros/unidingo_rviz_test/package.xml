<?xml version="1.0"?>
<package format="2">
  <name>unidingo_rviz_test</name>
  <version>1.0.0</version>
  <description>Whole-robot RViz TCP target sender for the Z1 hardware topic interface.</description>
  <maintainer email="maintainer@example.com">Z1-Dingo contributors</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <build_depend>qtbase5-dev</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>roscpp</depend>
  <depend>z1_control</depend>
  <depend>trajectory_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_visualization</depend>
  <exec_depend>rospy</exec_depend>
  <depend>geometry_msgs</depend>
  <exec_depend>sensor_msgs</exec_depend>
  <depend>std_msgs</depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>trac_ik_kinematics_plugin</exec_depend>
  <exec_depend>z1_msgs</exec_depend>
  <exec_depend>z1_bringup</exec_depend>
  <exec_depend>uni_dingo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <depend>rviz</depend>
  <depend>pluginlib</depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>python3-yaml</test_depend>
  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
