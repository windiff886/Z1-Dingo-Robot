<!-- Internal optional standalone models and TF, selected by publish_description.py. -->
<launch>
  <group ns="left_arm">
    <param name="robot_description" command="$(find xacro)/xacro '$(find z1_description)/urdf/z1.urdf.xacro' prefix:=left_"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="state_publisher"/>
  </group>
  <group ns="right_arm">
    <param name="robot_description" command="$(find xacro)/xacro '$(find z1_description)/urdf/z1.urdf.xacro' prefix:=right_"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="state_publisher"/>
  </group>
</launch>
