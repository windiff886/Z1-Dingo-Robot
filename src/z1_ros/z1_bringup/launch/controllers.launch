<!-- Internal shared controller setup; use arm.launch for standalone bringup. -->
<launch>
  <arg name="disable_friction" default="false"/>
  <rosparam command="load" file="$(find z1_bringup)/config/communication.yaml"/>
  <group ns="left_arm">
    <node pkg="z1_control" type="z1_topic_node" name="controller" output="screen">
      <rosparam command="load" file="$(find z1_bringup)/config/control.yaml"/>
      <param name="model_file" value="$(find z1_description)/urdf/z1_control.urdf"/>
      <param name="joint_prefix" value="left_"/>
      <param name="friction_file" value="$(find z1_control)/config/friction_compensation.yaml"/>
      <param name="friction_arm" value="left"/>
      <param name="friction_force_disabled" value="$(arg disable_friction)"/>
    </node>
  </group>
  <group ns="right_arm">
    <node pkg="z1_control" type="z1_topic_node" name="controller" output="screen">
      <rosparam command="load" file="$(find z1_bringup)/config/control.yaml"/>
      <param name="model_file" value="$(find z1_description)/urdf/z1_control.urdf"/>
      <param name="joint_prefix" value="right_"/>
      <param name="friction_file" value="$(find z1_control)/config/friction_compensation.yaml"/>
      <param name="friction_arm" value="right"/>
      <param name="friction_force_disabled" value="$(arg disable_friction)"/>
    </node>
  </group>
</launch>
