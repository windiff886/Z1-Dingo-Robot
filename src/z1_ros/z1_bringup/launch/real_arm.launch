<launch>
  <!-- 
    双臂机械臂启动文件（真实硬件）
    用法: roslaunch z1_bringup real_arm.launch
  -->
  <arg name="UnitreeGripperYN" default="true"/>

  <arg name="controller" default="true" />
  <arg name="ros_controller" default="true" />
  <arg name="moveit" default="false" />
  <arg name="rviz" default="false" />
  
  <!-- 双臂 IP 配置 -->
  <arg name="left_arm_ip" default="192.168.123.110"/>
  <arg name="right_arm_ip" default="192.168.123.111"/>

  <!-- 加载双臂 URDF (禁用云台) -->
  <param name="robot_description" command="$(find xacro)/xacro --inorder
    '$(find uni_dingo)/urdf/uni_dingo_dual_arm.urdf.xacro'
    UnitreeGripper:=$(arg UnitreeGripperYN)
    PanTilt:=false"/>

  <!-- ========== 左臂控制 (.110:8881) ========== -->
  <group ns="left_arm">
    <!-- 底层 SDK 控制器 -->
    <include file="$(find z1_bringup)/launch/real_ctrl.launch" if="$(arg controller)">
      <arg name="arm_ip" value="$(arg left_arm_ip)"/>
      <arg name="port_to_mcu" value="8881"/>
      <arg name="port_to_sdk" value="8871"/>
    </include>

    <!-- ros_control 硬件接口 -->
    <group if="$(arg ros_controller)">
      <rosparam file="$(find uni_dingo)/config/left_controllers.yaml" command="load"/>
      <node name="z1_hw_node" pkg="z1_hw" type="z1_hw_node" output="screen">
        <param name="UnitreeGripperYN" value="$(arg UnitreeGripperYN)"/>
        <param name="joint_prefix" value="left_"/>
        <param name="udp/mcu_ip" value="$(arg left_arm_ip)"/>
        <param name="udp/port_to_mcu" value="8881"/>
        <param name="udp/port_to_sdk" value="8871"/>
        <param name="udp_to_controller/controller_ip" value="127.0.0.1"/>
        <param name="udp_to_controller/own_port" value="8872"/>
      </node>
      <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen"
        args="left_joint_state_controller left_z1_joint_traj_controller"/>
    </group>
  </group>

  <!-- ========== 右臂控制 (.111:8882) ========== -->
  <group ns="right_arm">
    <!-- 底层 SDK 控制器 -->
    <include file="$(find z1_bringup)/launch/real_ctrl.launch" if="$(arg controller)">
      <arg name="arm_ip" value="$(arg right_arm_ip)"/>
      <arg name="port_to_mcu" value="8882"/>
      <arg name="port_to_sdk" value="8873"/>
    </include>

    <!-- ros_control 硬件接口 -->
    <group if="$(arg ros_controller)">
      <rosparam file="$(find uni_dingo)/config/right_controllers.yaml" command="load"/>
      <node name="z1_hw_node" pkg="z1_hw" type="z1_hw_node" output="screen">
        <param name="UnitreeGripperYN" value="$(arg UnitreeGripperYN)"/>
        <param name="joint_prefix" value="right_"/>
        <param name="udp/mcu_ip" value="$(arg right_arm_ip)"/>
        <param name="udp/port_to_mcu" value="8882"/>
        <param name="udp/port_to_sdk" value="8873"/>
        <param name="udp_to_controller/controller_ip" value="127.0.0.1"/>
        <param name="udp_to_controller/own_port" value="8874"/>
      </node>
      <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen"
        args="right_joint_state_controller right_z1_joint_traj_controller"/>
    </group>
  </group>

  <!-- MoveIt (可选) -->
  <include file="$(find z1_dual_moveit_config)/launch/move_group.launch" if="$(arg moveit)">
    <arg name="allow_trajectory_execution" value="true"/>
    <arg name="fake_execution" value="false"/>
  </include>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <include file="$(find z1_dual_moveit_config)/launch/moveit_rviz.launch" if="$(arg moveit)">
      <arg name="rviz_config" value="$(find z1_dual_moveit_config)/launch/moveit.rviz"/>
    </include>
    <include file="$(find z1_rviz)/launch/view_robot.launch" unless="$(arg moveit)"/>
  </group>

  <!-- 合并双臂关节状态 -->
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher">
    <rosparam param="source_list">[/left_arm/joint_states, /right_arm/joint_states]</rosparam>
    <param name="rate" value="200"/>
  </node>

  <!-- 机器人状态发布器 -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
</launch>
