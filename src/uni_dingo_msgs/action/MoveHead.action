# MoveHead.action
# Move the pan-tilt head

# Goal
uint8 SET_ANGLES = 0
uint8 LOOK_AT = 1
uint8 HOME = 2

uint8 command
float64 pan                           # For SET_ANGLES (rad)
float64 tilt                          # For SET_ANGLES (rad)
geometry_msgs/PointStamped look_at_point  # For LOOK_AT

---
# Result
bool success
string message
float64 final_pan
float64 final_tilt

---
# Feedback
float64 current_pan
float64 current_tilt
float64 progress
