<launch>
  <arg name="real" default="true" />
  <arg name="rviz" default="true" />
  <arg name="teleop" default="true" />
  <arg name="moveit" default="true" />

  <env name="real" value="$(arg real)" />
  <env name="rviz" value="$(arg rviz)" />
  <env name="teleop" value="$(arg teleop)" />
  <env name="moveit" value="$(arg moveit)" />

  <group unless="$(arg real)">
    <group if="$(arg teleop)">
      <include file="$(find dingo_base)/launch/base.launch">
        <arg name="teleop" value="keyboard" />
      </include>
    </group>
    <group unless="$(arg teleop)">
      <include file="$(find dingo_base)/launch/base.launch" />
    </group>

    <include file="$(find z1_bringup)/launch/real_arm.launch">
      <arg name="rviz" value="$(arg rviz)" />
      <arg name="moveit" value="$(arg moveit)" />
    </include>
  </group>
</launch>
