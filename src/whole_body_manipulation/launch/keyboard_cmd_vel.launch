<launch>
  <arg name="cmd_vel_topic" default="/cmd_vel" />
  <arg name="input_device" default="" />
  <arg name="key_hold_timeout" default="0.5" />

  <arg name="keyboard_config" default="$(eval optenv('DINGO_KEYBOARD_CONFIG', find('whole_body_manipulation') + '/config/keyboard_omni.yaml'
                           if int(optenv('DINGO_OMNI', 0)) else find('whole_body_manipulation') + '/config/keyboard_diff.yaml'))" />

  <arg name="teleop_config" default="$(eval optenv('DINGO_JOY_CONFIG', find('whole_body_manipulation') + '/config/teleop_omni.yaml'
                         if int(optenv('DINGO_OMNI', 0)) else find('whole_body_manipulation') + '/config/teleop_diff.yaml'))" />

  <node pkg="whole_body_manipulation" type="keyboard_cmd_vel" name="keyboard_cmd_vel" output="screen">
    <rosparam command="load" file="$(arg keyboard_config)" />
    <rosparam command="load" file="$(arg teleop_config)" />
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="input_device" value="$(arg input_device)" />
    <param name="key_hold_timeout" value="$(arg key_hold_timeout)" />
  </node>
</launch>
