<launch>
  <arg name="manager" default="d455_camera_manager" />
  <arg name="serial_no" default="" />
  <arg name="enable_color" default="true" />
  <arg name="enable_depth" default="true" />
  <arg name="color_width" default="640" />
  <arg name="color_height" default="480" />
  <arg name="color_fps" default="30" />
  <arg name="depth_width" default="640" />
  <arg name="depth_height" default="480" />
  <arg name="depth_fps" default="30" />
  <arg name="color_frame_id" default="d455_color_optical_frame" />
  <arg name="depth_frame_id" default="d455_depth_optical_frame" />

  <node pkg="nodelet" type="nodelet" name="$(arg manager)" args="manager" output="screen" />

  <node pkg="nodelet" type="nodelet" name="d455_camera"
        args="load d455_camera/D455CameraNodelet $(arg manager)" output="screen">
    <param name="serial_no" value="$(arg serial_no)" />
    <param name="enable_color" value="$(arg enable_color)" />
    <param name="enable_depth" value="$(arg enable_depth)" />
    <param name="color_width" value="$(arg color_width)" />
    <param name="color_height" value="$(arg color_height)" />
    <param name="color_fps" value="$(arg color_fps)" />
    <param name="depth_width" value="$(arg depth_width)" />
    <param name="depth_height" value="$(arg depth_height)" />
    <param name="depth_fps" value="$(arg depth_fps)" />
    <param name="color_frame_id" value="$(arg color_frame_id)" />
    <param name="depth_frame_id" value="$(arg depth_frame_id)" />
  </node>
</launch>
