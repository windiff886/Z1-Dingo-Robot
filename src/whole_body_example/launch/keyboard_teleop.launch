<launch>
    <!-- Keyboard Teleop for Uni-Dingo Robot -->

    <!-- Mode: 'simulation' or 'real' -->
    <arg name="mode" default="simulation"/>

    <node name="keyboard_teleop" pkg="whole_body_example" type="keyboard_teleop.py"
          output="screen" required="true">
        <param name="mode" value="$(arg mode)"/>
    </node>
</launch>
