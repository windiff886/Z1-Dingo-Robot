<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Schematic housing only. Optical extrinsics require physical calibration.
       The color frame name matches d455_camera/src/camera_config.h. -->
  <xacro:macro name="d455_visual" params="parent *origin">
    <link name="d455_link">
      <visual>
        <geometry><box size="0.026 0.124 0.029"/></geometry>
        <material name="d455_black"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <collision><geometry><box size="0.026 0.124 0.029"/></geometry></collision>
    </link>
    <joint name="d455_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="d455_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="d455_color_optical_frame"/>
    <joint name="d455_color_optical_joint" type="fixed">
      <parent link="d455_link"/><child link="d455_color_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>
</robot>
