<?xml version="1.0" encoding="UTF-8"?>
<!--
  查看 D455 相机模型和坐标系
  用法: roslaunch unidingo_description view_d455_only.launch
-->
<launch>

  <param name="robot_description" command="$(find xacro)/xacro --inorder $(find uni_dingo)/urdf/d455_only.urdf.xacro"/>

  <!-- 关节状态发布 -->
  <node name="joint_state_publisher" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui"/>

  <!-- 机器人状态发布 -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <!-- RViz -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find uni_dingo)/rviz/d455_only.rviz" required="true"/>

</launch>
