<?xml version="1.0"?>
<!--
  Dual Z1 arm URDF.
  Instantiates left and right Z1 arms with separate hardware interfaces.

  mcu_ip / port_to_mcu 已移至 z1_ctrl_ros2 节点参数，不在此处声明。
  Z1System 只需知道如何连接各自的 z1_ctrl_ros2（port_to_sdk / own_port）。
-->
<robot name="z1_dual_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="left_arm"            default="true"/>
    <xacro:arg name="right_arm"           default="true"/>
    <xacro:arg name="has_gripper"         default="true"/>
    <xacro:arg name="left_port_to_sdk"    default="8871"/>
    <xacro:arg name="left_own_port"       default="8872"/>
    <xacro:arg name="right_port_to_sdk"   default="8873"/>
    <xacro:arg name="right_own_port"      default="8874"/>

    <xacro:include filename="$(find z1_description)/urdf/z1.urdf.xacro"/>
    <xacro:include filename="$(find z1_description)/urdf/z1.ros2_control.xacro"/>

    <link name="world"/>

    <!-- Left arm: Z1System → z1_ctrl_ros2(left) @ 127.0.0.1:8871 -->
    <xacro:if value="$(arg left_arm)">
    <xacro:z1_arm prefix="left_" parent="world" xyz="0 0.2 0" rpy="0 0 0"
                  has_gripper="$(arg has_gripper)"/>
    <xacro:z1_ros2_control prefix="left_"
                           port_to_sdk="$(arg left_port_to_sdk)"
                           controller_ip="127.0.0.1"
                           own_port="$(arg left_own_port)"
                           has_gripper="$(arg has_gripper)"/>
    </xacro:if>

    <!-- Right arm: Z1System → z1_ctrl_ros2(right) @ 127.0.0.1:8873 -->
    <xacro:if value="$(arg right_arm)">
    <xacro:z1_arm prefix="right_" parent="world" xyz="0 -0.2 0" rpy="0 0 0"
                  has_gripper="$(arg has_gripper)"/>
    <xacro:z1_ros2_control prefix="right_"
                           port_to_sdk="$(arg right_port_to_sdk)"
                           controller_ip="127.0.0.1"
                           own_port="$(arg right_own_port)"
                           has_gripper="$(arg has_gripper)"/>
    </xacro:if>

</robot>
