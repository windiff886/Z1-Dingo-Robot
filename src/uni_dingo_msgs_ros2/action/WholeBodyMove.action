# WholeBodyMove.action
# Coordinated whole-body motion (base + arms)

# Goal
bool move_base
geometry_msgs/Pose2D base_target

bool move_left_arm
geometry_msgs/PoseStamped left_arm_target

bool move_right_arm
geometry_msgs/PoseStamped right_arm_target

bool move_head
geometry_msgs/PointStamped head_look_at

float64 velocity_scaling

---
# Result
bool success
string message
geometry_msgs/Pose2D final_base_pose
geometry_msgs/PoseStamped final_left_pose
geometry_msgs/PoseStamped final_right_pose

---
# Feedback
float64 overall_progress
string current_phase                  # "base", "arms", "head", "done"
float64 base_progress
float64 left_arm_progress
float64 right_arm_progress
float64 head_progress
