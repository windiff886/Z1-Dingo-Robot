# MoveArm.action
# Move an arm to a target pose or joint configuration

# Goal
uint8 MOVE_TO_POSE = 0
uint8 MOVE_TO_JOINTS = 1
uint8 MOVE_TO_NAMED = 2

uint8 move_type                       # Type of motion

geometry_msgs/PoseStamped target_pose # For MOVE_TO_POSE
float64[] target_joints               # For MOVE_TO_JOINTS
string named_target                   # For MOVE_TO_NAMED ("home", "ready", "tucked")

string planning_group                 # MoveIt planning group
float64 velocity_scaling              # 0.0 to 1.0
float64 acceleration_scaling          # 0.0 to 1.0
bool allow_replanning

---
# Result
bool success
string message
geometry_msgs/PoseStamped final_pose
float64[] final_joints

---
# Feedback
float64 progress                      # 0.0 to 1.0
string status                         # "planning", "executing", "done"
geometry_msgs/PoseStamped current_pose
