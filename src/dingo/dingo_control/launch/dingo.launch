<launch>
  <!-- Dingo-O Hardware Configuration -->
  <arg name="wireless_interface" default="$(optenv DINGO_WIRELESS_INTERFACE wlp2s0)" doc="Wireless interface for diagnostic reporting" />

  <!-- Topic Interface Configurations -->
  <arg name="cmd_vel_topic" default="/dingo/cmd_vel" doc="Primary external velocity command topic (geometry_msgs/Twist)" />
  <arg name="odom_topic" default="/dingo/odom" doc="Primary fused odometry topic (nav_msgs/Odometry)" />
  <arg name="odom_raw_topic" default="/dingo/odom_raw" doc="Auxiliary raw wheel odometry topic (nav_msgs/Odometry)" />
  <arg name="imu_raw_topic" default="/dingo/imu/data_raw" doc="Chassis IMU topic (sensor_msgs/Imu)" />
  <arg name="diagnostics_topic" default="/diagnostics" />
  <arg name="ekf_config" default="$(find dingo_control)/config/robot_localization.yaml" />

  <!-- TF & Model Toggles -->
  <arg name="load_description" default="true" doc="Load base robot_description URDF parameter" />
  <arg name="publish_odom_tf" default="false" doc="Publish odom -> base_link TF via EKF" />
  <arg name="publish_imu_tf" default="true" doc="Publish static base_link -> imu_link TF for EKF sensor fusion" />
  <!-- Defaults match the stock URDF; confirm the actual IMU mounting on the target. -->
  <arg name="imu_frame" default="imu_link" />
  <arg name="imu_x" default="0" />
  <arg name="imu_y" default="0" />
  <arg name="imu_z" default="0" />
  <arg name="imu_roll" default="0" />
  <arg name="imu_pitch" default="0" />
  <arg name="imu_yaw" default="0" />

  <!-- 1. Base Robot Model Description -->
  <param if="$(arg load_description)" name="robot_description"
         command="$(find xacro)/xacro '$(find dingo_description)/urdf/dingo.urdf.xacro'" />

  <!-- 2. Serial Message Info Service -->
  <node pkg="rosserial_python" type="message_info_service.py" name="rosserial_message_info" />

  <!-- 3. Chassis Hardware Driver Node -->
  <node pkg="dingo_base" type="dingo_node" name="dingo_node" output="screen">
    <rosparam command="load" file="$(find dingo_control)/config/hardware/base.yaml" />
    <param name="wireless_interface" value="$(arg wireless_interface)" />

    <!-- Connect velocity controller input and raw wheel odometry to configured topics -->
    <remap from="dingo_velocity_controller/cmd_vel" to="$(arg cmd_vel_topic)" />
    <remap from="dingo_velocity_controller/odom" to="$(arg odom_raw_topic)" />
    <!-- Direct chassis IMU data stream -->
    <remap from="imu/data_raw" to="$(arg imu_raw_topic)" />
    <remap from="diagnostics" to="$(arg diagnostics_topic)" />
  </node>

  <!-- 4. Controllers (Joint States & Velocity Controller) -->
  <include file="$(find dingo_control)/launch/control.launch" />

  <!-- 5. Chassis IMU Static Transform (base_link to imu_link) -->
  <node if="$(arg publish_imu_tf)" pkg="tf2_ros" type="static_transform_publisher"
        name="base_link_to_imu_link"
        args="$(arg imu_x) $(arg imu_y) $(arg imu_z) $(arg imu_yaw) $(arg imu_pitch) $(arg imu_roll) base_link $(arg imu_frame)" />

  <!-- 6. EKF Motion State Fusion (Wheel Odom + IMU Angular Velocity) -->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization" output="screen">
    <rosparam command="load" file="$(arg ekf_config)" />
    <param name="publish_tf" value="$(arg publish_odom_tf)" />
    <param name="print_diagnostics" value="true" />
    <param name="odom0" value="$(arg odom_raw_topic)" />
    <param name="imu0" value="$(arg imu_raw_topic)" />
    <remap from="odometry/filtered" to="$(arg odom_topic)" />
    <remap from="diagnostics" to="$(arg diagnostics_topic)" />
  </node>
</launch>

