<?xml version="1.0"?>
<!-- 独立 D455 可视化模型 -->
<robot name="d455_only" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_link"/>

  <link name="head_d455_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.124 0.026 0.029"/>
      </geometry>
      <material name="d455_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.124 0.026 0.029"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_d455_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="head_d455_link"/>
  </joint>

  <link name="head_d455_optical_frame"/>
  <joint name="head_d455_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="head_d455_link"/>
    <child link="head_d455_optical_frame"/>
  </joint>
</robot>
