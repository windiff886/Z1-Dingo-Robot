<launch>
  <!--
    Uni-Dingo Unified Bringup
    =========================

    Usage:
      roslaunch uni_dingo_api bringup.launch                    # Simulation with GUI
      roslaunch uni_dingo_api bringup.launch mode:=real         # Real robot
      roslaunch uni_dingo_api bringup.launch gui:=false         # Headless simulation
      roslaunch uni_dingo_api bringup.launch rviz:=false        # No RViz
      roslaunch uni_dingo_api bringup.launch head:=true         # Enable head
      roslaunch uni_dingo_api bringup.launch perception:=true   # Enable perception
  -->

  <!-- Operating mode -->
  <arg name="mode" default="simulation" doc="Operating mode: 'simulation' or 'real'" />

  <!-- Simulation settings -->
  <arg name="gui" default="true" doc="Launch Gazebo GUI" />
  <arg name="rviz" default="true" doc="Launch RViz" />
  <arg name="world" default="$(find dingo_gazebo)/worlds/dingo_race.world" />
  <arg name="paused" default="true" doc="Start Gazebo paused" />

  <!-- Robot configuration -->
  <arg name="teleop" default="none" doc="Teleop method: 'keyboard', 'joystick', or 'none'" />
  <arg name="moveit" default="true" doc="Enable MoveIt motion planning" />
  <arg name="auto_safe_pose" default="true" doc="Move arms to safe pose on startup" />

  <!-- Subsystem enables -->
  <arg name="base" default="true" />
  <arg name="left_arm" default="true" />
  <arg name="right_arm" default="true" />
  <arg name="head" default="true" doc="Enable pan-tilt head" />
  <arg name="perception" default="true" doc="Enable camera perception" />

  <!-- Robot spawn pose -->
  <arg name="x" default="0" />
  <arg name="y" default="0" />
  <arg name="z" default="0.1" />
  <arg name="yaw" default="0" />

  <!-- ==================== SIMULATION MODE ==================== -->
  <group if="$(eval arg('mode') == 'simulation')">

    <!-- Load unified config to parameter server -->
    <rosparam command="load" file="$(find uni_dingo_api)/config/robot_config.yaml" ns="uni_dingo" />
    <param name="uni_dingo/robot/mode" value="simulation" />

    <!-- Override subsystem enables based on args -->
    <param name="uni_dingo/subsystems/base/enabled" value="$(arg base)" />
    <param name="uni_dingo/subsystems/left_arm/enabled" value="$(arg left_arm)" />
    <param name="uni_dingo/subsystems/right_arm/enabled" value="$(arg right_arm)" />
    <param name="uni_dingo/subsystems/head/enabled" value="$(arg head)" />
    <param name="uni_dingo/subsystems/perception/enabled" value="$(arg perception)" />

    <!-- Launch the existing dual_arm_gazebo_moveit -->
    <include file="$(find uni_dingo)/launch/dual_arm_gazebo_moveit.launch">
      <arg name="gui" value="$(arg gui)" />
      <arg name="paused" value="$(arg paused)" />
      <arg name="world_name" value="$(arg world)" />
      <arg name="teleop" value="$(arg teleop)" />
      <arg name="joystick" value="$(eval arg('teleop') != 'none')" />
      <arg name="moveit" value="$(arg moveit)" />
      <arg name="rviz" value="$(arg rviz)" />
      <arg name="auto_safe_pose" value="$(arg auto_safe_pose)" />
      <arg name="x" value="$(arg x)" />
      <arg name="y" value="$(arg y)" />
      <arg name="z" value="$(arg z)" />
      <arg name="yaw" value="$(arg yaw)" />
    </include>

    <!-- Pan-Tilt Controllers (if head enabled) -->
    <group if="$(arg head)">
      <rosparam command="load" file="$(find uni_dingo_api)/config/pan_tilt_controllers.yaml" ns="pan_tilt" />
      <node name="pan_tilt_controller_spawner" pkg="controller_manager" type="spawner"
            args="pan_tilt/pan_tilt_joint_state_controller pan_tilt/pan_controller pan_tilt/tilt_controller"
            output="screen" respawn="false" />
    </group>

  </group>

  <!-- ==================== REAL ROBOT MODE ==================== -->
  <group if="$(eval arg('mode') == 'real')">

    <!-- Include the dedicated real robot launch file -->
    <include file="$(find uni_dingo_api)/launch/real_robot.launch">
      <arg name="base" value="$(arg base)" />
      <arg name="left_arm" value="$(arg left_arm)" />
      <arg name="right_arm" value="$(arg right_arm)" />
      <arg name="head" value="$(arg head)" />
      <arg name="perception" value="$(arg perception)" />
      <arg name="moveit" value="$(arg moveit)" />
      <arg name="rviz" value="$(arg rviz)" />
    </include>

  </group>

  <!-- ==================== COMMON NODES (Simulation Only) ==================== -->
  <!-- Note: real_robot.launch includes its own state publisher -->

  <group if="$(eval arg('mode') == 'simulation')">
    <!-- Robot state publisher node (publishes unified robot state) -->
    <node pkg="uni_dingo_api" type="robot_state_publisher.py" name="uni_dingo_state_publisher" output="screen">
      <param name="publish_rate" value="10.0" />
    </node>
  </group>

</launch>
